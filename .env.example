# Copy to .env for local development (.env is git-ignored).
# Heroku: plain names as config vars. Coolify: set them in the app's Environment.
#
# [BUILD]   read by nuxt.config.ts at build time. In Coolify enable "Build Variable";
#           they are passed to the Dockerfile as build ARGs. A change needs a rebuild.
# [RUNTIME] server-only secrets. In Coolify use the NUXT_ form so Nitro overrides
#           runtimeConfig when the container starts (REGISTER_TOKEN -> NUXT_REGISTER_TOKEN).
#           Locally and on Heroku the plain name works too.
#           Nitro parses NUXT_ values: a purely numeric value becomes a number
#           (LOGIN_PASSWORD is compared strictly, so it needs at least one letter).

# ---- Rails API (smartwendelerland-api), base URL ending in /v1/ -- [BUILD]
API_BASE_URL=

# ---- Public API basic auth, registration, password protection -- [RUNTIME]
NUXT_PUBLIC_API_USERNAME=
NUXT_PUBLIC_API_PASSWORD=
NUXT_REGISTER_TOKEN=
NUXT_LOGIN_PASSWORD=

# ---- Set by the container, only change when needed
# PORT=3000
# HOST=0.0.0.0
